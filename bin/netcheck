#!/data/data/com.termux/files/usr/bin/bash

# netcheck - Network diagnostics for Termux
# Author: Khayom Abdurahmonov (Khayom1.github.io)

echo ""
echo "┌─────────────────────────────────────┐"
echo "│         NETWORK CHECK               │"
echo "└─────────────────────────────────────┘"
echo ""

# IP addresses
echo " Local IP:"
ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -5 | while read ip; do
  echo "   → $ip"
done

echo ""
echo " Public IP:"
PUBLIC_IP=$(curl -s --max-time 5 ifconfig.me 2>/dev/null || curl -s --max-time 5 ipinfo.io/ip 2>/dev/null || echo "Unavailable")
echo "   → $PUBLIC_IP"

echo ""
echo " Connectivity:"
if ping -c 1 -W 2 8.8.8.8 &>/dev/null; then
  echo "   → Internet: OK"
else
  echo "   → Internet: FAILED"
fi

if ping -c 1 -W 2 github.com &>/dev/null; then
  echo "   → GitHub:   OK"
else
  echo "   → GitHub:   FAILED"
fi

echo ""
echo "─────────────────────────────────────"
echo " Author: Khayom1.github.io"
echo ""
