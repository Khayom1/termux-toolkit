#!/data/data/com.termux/files/usr/bin/bash

# sysinfo - Beautiful system information for Termux
# Author: Khayom Abdurahmonov (Khayom1.github.io)

echo ""
echo "┌─────────────────────────────────────┐"
echo "│         TERMUX SYSTEM INFO          │"
echo "└─────────────────────────────────────┘"
echo ""

echo " Device     : $(getprop ro.product.model 2>/dev/null || echo 'Unknown')"
echo " Android    : $(getprop ro.build.version.release 2>/dev/null || echo 'Unknown')"
echo " Arch       : $(uname -m)"
echo " Kernel     : $(uname -r)"
echo ""
echo " Uptime     : $(uptime -p 2>/dev/null || uptime)"
echo " Shell      : $SHELL"
echo " Termux     : $PREFIX"
echo ""
echo " Memory:"
free -h 2>/dev/null | awk 'NR==2{printf "   Used: %s / %s (%.0f%%)\n", $3, $2, $3*100/$2}'
echo ""
echo " Storage:"
df -h $HOME 2>/dev/null | awk 'NR==2{printf "   Used: %s / %s (%s)\n", $3, $2, $5}'
echo ""
echo "─────────────────────────────────────"
echo " Author: Khayom1.github.io"
echo ""
